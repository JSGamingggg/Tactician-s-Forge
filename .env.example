# RIOT_API_KEY: Required for live Riot Games TFT API calls (Account-v1, TFT-Summoner-v1, TFT-League-v1, TFT-Match-v1).
# Configure your Riot Games Developer API key securely via the Secrets panel in AI Studio.
RIOT_API_KEY=MY_RIOT_API_KEY

# GITHUB_REPO: Optional GitHub "owner/repo" for in-app APK self-updates (auto-populated during GitHub Actions builds).
GITHUB_REPO=MY_GITHUB_OWNER_REPO

