# GITHUB_REPO: GitHub "owner/repo" for in-app APK self-updates (auto-populated during GitHub Actions builds).
GITHUB_REPO=JSGamingggg/Tactician-s-Forge

# GITHUB_TOKEN: GitHub Personal Access Token (with Contents: Read permission) for in-app APK updates from Private GitHub repositories.
GITHUB_TOKEN=MY_GITHUB_TOKEN

# GH_RELEASE_TOKEN: Optional alias for GITHUB_TOKEN in AI Studio Secrets or GitHub Actions Secrets.
GH_RELEASE_TOKEN=MY_GH_RELEASE_TOKEN
